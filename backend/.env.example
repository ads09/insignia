# HTTP
PORT=3000
# Comma-separated list of origins allowed by CORS (the frontend dev server by default)
CORS_ORIGINS=http://localhost:5173

# Database (matches the root docker-compose.yml defaults)
DATABASE_URL=postgresql://insignia:insignia@localhost:5432/insignia?schema=public

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Administrator account created by `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
