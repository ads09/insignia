# SITE_ADDRESS is the domain pointing at the server: Caddy obtains and renews
# its Let's Encrypt certificate automatically. Use :80 for plain HTTP.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# /api/login -> api:3000/login
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle /docs* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes such as /transactions are served index.html.
		try_files {path} /index.html
		file_server
	}
}
